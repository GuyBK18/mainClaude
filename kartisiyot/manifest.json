{
  "manifest_version": 3,
  "name": "כרטיסיות",
  "description": "קבוצות הלשוניות של כרום ככרטיסים: שמות, סטטוס, משימה ופתיחה ישירה בקלוד.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "sidePanel", "favicon"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "כרטיסיות",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" },
      "description": "פתיחת החלונית"
    }
  }
}
