# Optional settings. Copy to .env.local and restart `npm run dev`.

# Folder for the library backup. Defaults to iCloud Drive/LuminaRead, or ~/Documents/LuminaRead
# on a Mac without iCloud Drive.
# LUMINAREAD_DATA_DIR=~/Documents/LuminaRead

# Google Books works without a key, but shares a daily quota per IP address.
# If searches start failing with "rate limited", add a free key from
# https://console.cloud.google.com/apis/library/books.googleapis.com
# GOOGLE_BOOKS_API_KEY=

# Goodreads has no public API; the importer reads its public book page.
# Set to "off" to skip Goodreads (ratings then come from Open Library or Google Books).
# LUMINAREAD_GOODREADS=off
